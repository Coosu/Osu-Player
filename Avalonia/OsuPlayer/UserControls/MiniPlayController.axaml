<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Milki.OsuPlayer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="80"
             x:Class="Milki.OsuPlayer.UserControls.MiniPlayController"
             x:DataType="vm:PlayControllerViewModel"
             FontFamily="{StaticResource SspRegular}">

    <UserControl.Styles>
        <Style Selector="Button.MiniIconButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.MiniIconButton:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="#80E0E0E0" />
        </Style>

        <Style Selector="Button.MiniIconButton:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="#80D0D0D0" />
        </Style>

        <Style Selector="Button.CloseMiniButton:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="#30A06349" />
        </Style>

        <Style Selector="Slider.MiniProgress">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="5" />
            <Setter Property="MinHeight" Value="5" />
        </Style>

        <Style Selector="Slider.MiniProgress /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Height="5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0" Color="#00A0A0A0" />
                                <GradientStop Offset="1" Color="#A0E04452" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Slider.MiniProgress /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Height="5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0" Color="#00A0A0A0" />
                                <GradientStop Offset="1" Color="#C0FFFFFF" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Slider.MiniProgress /template/ Thumb#PART_Thumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Ellipse Width="2" Height="2" Fill="#C0E04452">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="5" Opacity="0.75" Color="#C0E04452" />
                        </Ellipse.Effect>
                    </Ellipse>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 背景图片 -->
        <Border x:Name="BgBorder" Grid.RowSpan="3" ClipToBounds="True" Opacity="0.8">
            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        
        <!-- 背景覆盖层 -->
        <Rectangle x:Name="RectCover" Grid.Row="0" Grid.RowSpan="3" Fill="#C0FFFFFF"/>

        <Border x:Name="OsuBg" Grid.Row="0" Grid.RowSpan="3" Background="{StaticResource TextureBrush3}" />
        
        <!-- 顶部控制按钮 -->
        <StackPanel Grid.Row="0" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
            <Button x:Name="VolumeButton" Classes="MiniIconButton" Width="18" Height="18" Margin="2">
                <!-- 音量图标 -->
                <Path Data="M842 454c0-4.4-3.6-8-8-8h-60c-4.4 0-8 3.6-8 8 0 140.3-113.7 254-254 254-4.4 0-8 3.6-8 8v60c0 4.4 3.6 8 8 8 190.5 0 346-155.5 346-346zm-98-98c0-4.4-3.6-8-8-8h-60c-4.4 0-8 3.6-8 8 0 84.2-68.8 153-153 153-4.4 0-8 3.6-8 8v60c0 4.4 3.6 8 8 8 134.4 0 245-110.6 245-245zm-240-42c-39.5 0-76.2 13.4-104.8 35.7-10.7 8.4-13.2 23.9-5.6 35.2l22.2 33.4c7 10.4 20.9 14.3 32.7 8.6 15.3-7.5 32.5-11.7 50.5-11.7 62 0 113 51 113 113 0 18-4.2 35.2-11.7 50.5-5.7 11.8-1.8 25.7 8.6 32.7l33.4 22.2c11.3 7.5 26.8 5 35.2-5.6C794.6 536.2 808 499.5 808 460c0-97.2-78.8-176-176-176z"
                      Fill="#646C77" Stretch="Uniform" Width="17" Height="17"/>
            </Button>
            
            <Button x:Name="LikeButton" Classes="MiniIconButton" Width="18" Height="18" Margin="2"
                    Command="{Binding ToggleFavoriteCommand}">
                <!-- 收藏图标 -->
                <ContentControl Content="{Binding IsFavorite, Converter={StaticResource BoolIsFavToSvgConverter}}" 
                                Width="18" Height="18" />
            </Button>
        </StackPanel>
        
        <!-- 右上角控制按钮 -->
        <StackPanel Grid.Row="0" Grid.RowSpan="3" Margin="2" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
            <Button x:Name="PlayListButton" Classes="MiniIconButton" Width="14" Height="14" Margin="2,1">
                <!-- 播放列表图标 -->
                <Path Data="M912 192H328c-4.4 0-8 3.6-8 8v56c0 4.4 3.6 8 8 8h584c4.4 0 8-3.6 8-8v-56c0-4.4-3.6-8-8-8zm0 284H328c-4.4 0-8 3.6-8 8v56c0 4.4 3.6 8 8 8h584c4.4 0 8-3.6 8-8v-56c0-4.4-3.6-8-8-8zm0 284H328c-4.4 0-8 3.6-8 8v56c0 4.4 3.6 8 8 8h584c4.4 0 8-3.6 8-8v-56c0-4.4-3.6-8-8-8zM104 228a56 56 0 1 0 112 0 56 56 0 1 0-112 0zm0 284a56 56 0 1 0 112 0 56 56 0 1 0-112 0zm0 284a56 56 0 1 0 112 0 56 56 0 1 0-112 0z"
                      Fill="#646C77" Stretch="Uniform" Width="13" Height="13"/>
            </Button>
            
            <Button x:Name="ModeButton" Classes="MiniIconButton" Width="14" Height="14" Margin="2,1">
                <!-- 播放模式图标 -->
                <ContentControl Content="{Binding PlayMode, Converter={StaticResource PlayModeToIconConverter}}" 
                                Width="13" Height="13" />
            </Button>
            
            <Button x:Name="MaxButton" Classes="MiniIconButton" Width="14" Height="14" Margin="2,1" Content="▢" Foreground="#646C77"/>
            
            <Button x:Name="CloseButton" Classes="MiniIconButton CloseMiniButton" Width="14" Height="14" Margin="1" Content="×" Foreground="#646C77"/>
        </StackPanel>
        
        <!-- 中央播放控制按钮 -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <Button x:Name="PrevButton" Classes="MiniIconButton" Width="28" Height="28"
                    Command="{Binding PlayPreviousCommand}">
                <!-- 上一曲图标 -->
                <Path Data="M352 192H96v-64h256a64 64 0 0 1 64 64v320a64 64 0 0 1-64 64H96v-64h256V192z"
                      Fill="#646C77" Stretch="Uniform" Width="16" Height="16"/>
            </Button>
            
            <Button x:Name="PlayPauseButton" Classes="MiniIconButton" Width="28" Height="28"
                    Command="{Binding PlayPauseCommand}">
                <!-- 播放/暂停图标 -->
                <Path Data="{Binding IsPlaying, Converter={StaticResource BoolToPlayPauseIconConverter}}"
                      Fill="#646C77" Stretch="Uniform" Width="{Binding IsPlaying, Converter={StaticResource BoolToSizeConverter}}"
                      Height="{Binding IsPlaying, Converter={StaticResource BoolToSizeConverter}}"/>
            </Button>
            
            <Button x:Name="NextButton" Classes="MiniIconButton" Width="28" Height="28"
                    Command="{Binding PlayNextCommand}">
                <!-- 下一曲图标 -->
                <Path Data="M928 160H672v64h256v320H672v64h256a64 64 0 0 0 64-64V224a64 64 0 0 0-64-64z"
                      Fill="#646C77" Stretch="Uniform" Width="16" Height="16"/>
            </Button>
        </StackPanel>
        
        <!-- 歌曲信息 -->
        <TextBlock Grid.Row="1" Margin="8,0,8,3" HorizontalAlignment="Center" Foreground="#303030">
            <Run Text="{Binding Title}" />
            <Run Text="-" />
            <Run Text="{Binding Artist}" Foreground="#484848" />
        </TextBlock>
        
        <!-- 进度条 -->
        <Slider Grid.Row="2" Classes="MiniProgress" Minimum="0" Maximum="100" Value="{Binding Progress}"
                VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
