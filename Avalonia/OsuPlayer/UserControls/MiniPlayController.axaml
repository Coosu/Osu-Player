<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Milki.OsuPlayer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="80"
             x:Class="Milki.OsuPlayer.UserControls.MiniPlayController"
             x:DataType="vm:PlayControllerViewModel">

    <UserControl.DataContext>
        <vm:PlayControllerViewModel/>
    </UserControl.DataContext>
    
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 背景图片 -->
        <Border x:Name="BgBorder" Grid.RowSpan="3" ClipToBounds="True" Opacity="0.8">
            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        
        <!-- 背景覆盖层 -->
        <Rectangle x:Name="RectCover" Grid.Row="0" Grid.RowSpan="3" Fill="#C0FFFFFF"/>
        
        <!-- 顶部控制按钮 -->
        <StackPanel Grid.Row="0" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
            <Button x:Name="VolumeButton" Width="18" Height="18" Margin="2" Background="Transparent" BorderThickness="0">
                <!-- 音量图标 -->
                <Path Data="M842 454c0-4.4-3.6-8-8-8h-60c-4.4 0-8 3.6-8 8 0 140.3-113.7 254-254 254-4.4 0-8 3.6-8 8v60c0 4.4 3.6 8 8 8 190.5 0 346-155.5 346-346zm-98-98c0-4.4-3.6-8-8-8h-60c-4.4 0-8 3.6-8 8 0 84.2-68.8 153-153 153-4.4 0-8 3.6-8 8v60c0 4.4 3.6 8 8 8 134.4 0 245-110.6 245-245zm-240-42c-39.5 0-76.2 13.4-104.8 35.7-10.7 8.4-13.2 23.9-5.6 35.2l22.2 33.4c7 10.4 20.9 14.3 32.7 8.6 15.3-7.5 32.5-11.7 50.5-11.7 62 0 113 51 113 113 0 18-4.2 35.2-11.7 50.5-5.7 11.8-1.8 25.7 8.6 32.7l33.4 22.2c11.3 7.5 26.8 5 35.2-5.6C794.6 536.2 808 499.5 808 460c0-97.2-78.8-176-176-176z"
                      Fill="#646C77" Stretch="Uniform" Width="17" Height="17"/>
            </Button>
            
            <Button x:Name="LikeButton" Width="18" Height="18" Margin="2" Background="Transparent" BorderThickness="0">
                <!-- 收藏图标 -->
                <Path Data="M923 283.6a260.04 260.04 0 0 0-56.9-82.8 264.4 264.4 0 0 0-84-55.5A265.34 265.34 0 0 0 679.7 125c-49.3 0-97.4 13.5-139.2 39-10 6.1-19.5 12.8-28.5 20.1-9-7.3-18.5-14-28.5-20.1-41.8-25.5-89.9-39-139.2-39-35.5 0-69.9 6.8-102.4 20.3-31.4 13-59.7 31.7-84 55.5a258.44 258.44 0 0 0-56.9 82.8c-13.9 32.3-21 66.6-21 101.9 0 33.3 6.8 68 20.3 103.3 11.3 29.5 27.5 60.1 48.2 91 32.8 48.9 77.9 99.9 133.9 151.6 92.8 85.7 184.7 144.9 188.6 147.3l23.7 15.2c10.5 6.7 24 6.7 34.5 0l23.7-15.2c3.9-2.5 95.7-61.6 188.6-147.3 56-51.7 101.1-102.7 133.9-151.6 20.7-30.9 37-61.5 48.2-91 13.5-35.3 20.3-70 20.3-103.3.1-35.3-7-69.6-20.9-101.9z"
                      Fill="{Binding IsFavorite, Converter={StaticResource BoolToColorConverter}}" Stretch="Uniform" Width="18" Height="18"/>
            </Button>
        </StackPanel>
        
        <!-- 右上角控制按钮 -->
        <StackPanel Grid.Row="0" Grid.RowSpan="3" Margin="2" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
            <Button x:Name="PlayListButton" Width="14" Height="14" Margin="2,1" Background="Transparent" BorderThickness="0">
                <!-- 播放列表图标 -->
                <Path Data="M912 192H328c-4.4 0-8 3.6-8 8v56c0 4.4 3.6 8 8 8h584c4.4 0 8-3.6 8-8v-56c0-4.4-3.6-8-8-8zm0 284H328c-4.4 0-8 3.6-8 8v56c0 4.4 3.6 8 8 8h584c4.4 0 8-3.6 8-8v-56c0-4.4-3.6-8-8-8zm0 284H328c-4.4 0-8 3.6-8 8v56c0 4.4 3.6 8 8 8h584c4.4 0 8-3.6 8-8v-56c0-4.4-3.6-8-8-8zM104 228a56 56 0 1 0 112 0 56 56 0 1 0-112 0zm0 284a56 56 0 1 0 112 0 56 56 0 1 0-112 0zm0 284a56 56 0 1 0 112 0 56 56 0 1 0-112 0z"
                      Fill="#646C77" Stretch="Uniform" Width="13" Height="13"/>
            </Button>
            
            <Button x:Name="ModeButton" Width="14" Height="14" Margin="2,1" Background="Transparent" BorderThickness="0">
                <!-- 播放模式图标 -->
                <Path Data="M512 64C264.6 64 64 264.6 64 512s200.6 448 448 448 448-200.6 448-448S759.4 64 512 64zm0 820c-205.4 0-372-166.6-372-372s166.6-372 372-372 372 166.6 372 372-166.6 372-372 372z"
                      Fill="#646C77" Stretch="Uniform" Width="13" Height="13"/>
            </Button>
            
            <Button x:Name="MaxButton" Width="14" Height="14" Margin="2,1" Background="Transparent" BorderThickness="0" Content="▢" Foreground="#646C77"/>
            
            <Button x:Name="CloseButton" Width="14" Height="14" Margin="1" Background="Transparent" BorderThickness="0" Content="×" Foreground="#646C77"/>
        </StackPanel>
        
        <!-- 中央播放控制按钮 -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <Button x:Name="PrevButton" Width="28" Height="28" Background="Transparent" BorderThickness="0">
                <!-- 上一曲图标 -->
                <Path Data="M352 192H96v-64h256a64 64 0 0 1 64 64v320a64 64 0 0 1-64 64H96v-64h256V192z"
                      Fill="#646C77" Stretch="Uniform" Width="16" Height="16"/>
            </Button>
            
            <Button x:Name="PlayPauseButton" Width="28" Height="28" Background="Transparent" BorderThickness="0">
                <!-- 播放/暂停图标 -->
                <Path Data="{Binding IsPlaying, Converter={StaticResource BoolToPlayPauseIconConverter}}"
                      Fill="#646C77" Stretch="Uniform" Width="{Binding IsPlaying, Converter={StaticResource BoolToSizeConverter}}"
                      Height="{Binding IsPlaying, Converter={StaticResource BoolToSizeConverter}}"/>
            </Button>
            
            <Button x:Name="NextButton" Width="28" Height="28" Background="Transparent" BorderThickness="0">
                <!-- 下一曲图标 -->
                <Path Data="M928 160H672v64h256v320H672v64h256a64 64 0 0 0 64-64V224a64 64 0 0 0-64-64z"
                      Fill="#646C77" Stretch="Uniform" Width="16" Height="16"/>
            </Button>
        </StackPanel>
        
        <!-- 歌曲信息 -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#333" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Artist}" FontSize="10" Foreground="#666" HorizontalAlignment="Center"/>
        </StackPanel>
        
        <!-- 进度条 -->
        <Slider Grid.Row="2" Margin="10,0" Minimum="0" Maximum="100" Value="{Binding Progress}"
                Height="4" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>