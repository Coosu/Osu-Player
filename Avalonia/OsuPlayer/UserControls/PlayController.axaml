<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:userControls="clr-namespace:Milki.OsuPlayer.UserControls"
             xmlns:vm="clr-namespace:Milki.OsuPlayer.ViewModels"
             xmlns:converters="clr-namespace:Milki.OsuPlayer.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="46"
             x:Class="Milki.OsuPlayer.UserControls.PlayController"
             x:DataType="vm:PlayControllerViewModel"
             FontFamily="{StaticResource SspRegular}">

    <!-- 资源定义 -->
    <UserControl.Resources>
        <!-- 在这里可以添加转换器 -->
    </UserControl.Resources>
    
    <UserControl.Styles>
        <!-- 全屏按钮样式 -->
        <Style Selector="Button.FullScrButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <ContentPresenter Content="{TemplateBinding Content}" />
                        <Border x:Name="FullScr" Background="#40000000" Opacity="0">
                            <Viewbox Width="30" Height="30" Stretch="Uniform">
                                <Canvas Width="1000" Height="1000">
                                    <Path Fill="#F0F0F0" Data="M602.1 500l226.5 226.5l91.9-91.9c11.5-12.1 29.4-15.3 44.7-8.9c14.7 6.4 24.9 21.1 24.9 37.6v285.8c0 22.3-18.5 40.8-40.8 40.8H663.3c-16.6 0-31.3-10.2-37.6-25.5c-6.4-14.7-3.2-32.5 8.9-44l91.9-91.9L500 602.1L273.5 828.6l91.9 91.9c12.1 11.5 15.3 29.4 8.9 44c-6.4 15.3-21.1 25.5-37.6 25.5H50.8C28.5 990 10 971.5 10 949.2V663.3c0-16.6 10.2-31.3 25.5-37.6c14.7-6.4 32.5-3.2 44 8.9l91.9 91.9L397.9 500L171.4 273.5l-91.9 91.9c-7.7 7.7-17.9 12.1-28.7 12.1c-5.1 0-10.8-1.3-15.3-3.2C20.2 367.9 10 353.3 10 336.7V50.8C10 28.5 28.5 10 50.8 10h285.8c16.6 0 31.3 10.2 37.6 25.5c6.4 14.7 3.2 32.5-8.9 44l-91.9 91.9L500 397.9l226.5-226.5l-91.9-91.9c-12.1-11.5-15.3-29.3-8.9-44c6.4-15.3 21.1-25.5 37.6-25.5h285.8c22.3 0 40.8 18.5 40.8 40.8v285.8c0 16.6-10.2 31.3-24.9 37.6c-5.1 1.9-10.8 3.2-16 3.2c-10.8 0-21.1-4.5-28.7-12.1l-91.9-91.9L602.1 500z" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        
        <!-- FullScrButton悬停效果 -->
        <Style Selector="Button.FullScrButton:pointerover Border#FullScr">
            <Setter Property="Opacity" Value="1" />
        </Style>
        
        <!-- 控制按钮样式 -->
        <Style Selector="Button.ControlButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource TextureBrush}" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        
        <!-- 控制按钮悬停效果 -->
        <Style Selector="Button.ControlButton:pointerover /template/ Border#PART_Border">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#F05090" />
                    <GradientStop Offset="1" Color="#E05888" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        
        <!-- 控制按钮按下效果 -->
        <Style Selector="Button.ControlButton:pressed /template/ Border#PART_Border">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#E04070" />
                    <GradientStop Offset="1" Color="#F05090" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.OpenControlButton">
            <Setter Property="Background" Value="{StaticResource OsuTextureBlueBrush}" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style Selector="Button.OpenControlButton:pointerover /template/ Border#PART_Border">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#5D9CEC" />
                    <GradientStop Offset="1" Color="#4D8CDC" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.OpenControlButton:pressed /template/ Border#PART_Border">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#3D7CCC" />
                    <GradientStop Offset="1" Color="#4D8CDC" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        
        <!-- 透明按钮样式 -->
        <Style Selector="Button.InvisibleButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        
        <!-- 透明按钮悬停效果 -->
        <Style Selector="Button.InvisibleButton:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="#80F8F8F8" />
        </Style>
        
        <!-- 透明按钮按下效果 -->
        <Style Selector="Button.InvisibleButton:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="#80E8E8E8" />
        </Style>
    </UserControl.Styles>
    
    <Grid Background="{StaticResource TextureBrush3}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <!-- 缩略图按钮 -->
        <Button x:Name="ThumbButton" Grid.Column="0"
                Width="61" Height="46" Margin="1"
                Classes="FullScrButton">
            <Image x:Name="Thumb" Source="{Binding Thumbnail}" Stretch="UniformToFill" />
        </Button>
        
        <!-- 控制按钮区域 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,10,0">
            <Button x:Name="PrevButton" Classes="ControlButton"
                    Command="{Binding PlayPreviousCommand}">
                <!-- 上一曲图标 -->
                <Path Data="M352 192H96v-64h256a64 64 0 0 1 64 64v320a64 64 0 0 1-64 64H96v-64h256V192z" 
                      Fill="White" Stretch="Uniform" Width="16" Height="16" />
            </Button>
            
            <Button x:Name="PlayButton" Classes="ControlButton"
                    Width="32" Height="32"
                    Command="{Binding PlayPauseCommand}">
                <!-- 播放/暂停图标 -->
                <Path Data="{Binding IsPlaying, Converter={StaticResource BoolToPlayPauseIconConverter}}" 
                      Fill="White" Stretch="Uniform" 
                      Width="{Binding IsPlaying, Converter={StaticResource BoolToSizeConverter}}" 
                      Height="{Binding IsPlaying, Converter={StaticResource BoolToSizeConverter}}" />
            </Button>
            
            <Button x:Name="NextButton" Classes="ControlButton"
                    Command="{Binding PlayNextCommand}">
                <!-- 下一曲图标 -->
                <Path Data="M928 160H672v64h256v320H672v64h256a64 64 0 0 0 64-64V224a64 64 0 0 0-64-64z" 
                      Fill="White" Stretch="Uniform" Width="16" Height="16" />
            </Button>
            
            <Button x:Name="OpenButton" Classes="ControlButton OpenControlButton">
                <!-- 打开文件图标 -->
                <Path Data="M928 444H820V330.4c0-17.7-14.3-32-32-32H473L355.7 186.2a8.15 8.15 0 0 0-5.5-2.2H96c-17.7 0-32 14.3-32 32v592c0 17.7 14.3 32 32 32h698c13 0 24.8-7.9 29.7-20l134-332c1.5-3.8 2.3-7.9 2.3-12 0-17.7-14.3-32-32-32zm-180 0H238c-13 0-24.8 7.9-29.7 20L136 643.2V256h188.5l119.6 114.4H748V444z" 
                      Fill="White" Stretch="Uniform" Width="16" Height="16" />
            </Button>
        </StackPanel>
        
        <!-- 进度条和信息区域 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <!-- 歌曲信息 -->
            <Grid Grid.Row="0" Margin="0,1,0,-3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Classes="InvisibleButton"
                        Margin="3,0" Command="{Binding ShowDetails}">
                    <TextBlock>
                        <Run Text="{Binding Title}" Foreground="#777" />
                        <Run Text="-" />
                        <Run Text="{Binding Artist}" Foreground="#AAA" />
                    </TextBlock>
                </Button>
                
                <Button x:Name="BtnAsio" Grid.Column="1" Classes="InvisibleButton"
                        Height="20" Margin="3,0" Padding="4,0" HorizontalAlignment="Right"
                        IsVisible="False">
                    <!-- ASIO图标将在需要时添加 -->
                </Button>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Name="LblProgress">
                    <TextBlock x:Name="LblNow" Text="{Binding CurrentPositionString}" Foreground="#777" VerticalAlignment="Center" />
                    <TextBlock Text="/" Margin="-5,0" Foreground="#858585" VerticalAlignment="Center" />
                    <TextBlock x:Name="LblTotal" Text="{Binding TotalDurationString}" Foreground="#AAA" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            
            <!-- 进度条 -->
            <Slider x:Name="PlayProgress" Grid.Row="1" Margin="3" 
                    Minimum="0" Maximum="100" Value="{Binding Progress}"
                    Classes="PinkSlider" />
        </Grid>
        
        <!-- 功能按钮区域 -->
        <Grid Grid.Column="3">
            <StackPanel x:Name="FuncPanel" Orientation="Horizontal" Margin="10,0,10,0" VerticalAlignment="Center">
                <Button x:Name="ModeButton" Classes="InvisibleButton"
                        Width="24" Height="24" Margin="8"
                        Click="ModeButton_Click">
                    <!-- 播放模式图标 -->
                    <Path Data="{Binding PlayMode, Converter={StaticResource PlayModeToIconConverter}}" 
                          Fill="White" Stretch="Uniform" Width="20" Height="20" />
                </Button>
                
                <Button x:Name="LikeButton" Classes="InvisibleButton"
                        Width="23" Height="23" Margin="6"
                        Command="{Binding ToggleFavoriteCommand}">
                    <!-- 收藏图标 -->
                    <Path Data="M923 283.6a260.04 260.04 0 0 0-56.9-82.8 264.4 264.4 0 0 0-84-55.5A265.34 265.34 0 0 0 679.7 125c-49.3 0-97.4 13.5-139.2 39-10 6.1-19.5 12.8-28.5 20.1-9-7.3-18.5-14-28.5-20.1-41.8-25.5-89.9-39-139.2-39-35.5 0-69.9 6.8-102.4 20.3-31.4 13-59.7 31.7-84 55.5a258.44 258.44 0 0 0-56.9 82.8c-13.9 32.3-21 66.6-21 101.9 0 33.3 6.8 68 20.3 103.3 11.3 29.5 27.5 60.1 48.2 91 32.8 48.9 77.9 99.9 133.9 151.6 92.8 85.7 184.7 144.9 188.6 147.3l23.7 15.2c10.5 6.7 24 6.7 34.5 0l23.7-15.2c3.9-2.5 95.7-61.6 188.6-147.3 56-51.7 101.1-102.7 133.9-151.6 20.7-30.9 37-61.5 48.2-91 13.5-35.3 20.3-70 20.3-103.3.1-35.3-7-69.6-20.9-101.9z" 
                          Fill="{Binding IsFavorite, Converter={StaticResource BoolToColorConverter}}" 
                          Stretch="Uniform" Width="18" Height="18" />
                </Button>
                
                <Button x:Name="VolumeButton" Classes="InvisibleButton"
                        Width="23" Height="23" Margin="6"
                        Click="VolumeButton_Click">
                    <!-- 音量图标 -->
                    <Path Data="M842 454c0-4.4-3.6-8-8-8h-60c-4.4 0-8 3.6-8 8 0 140.3-113.7 254-254 254-4.4 0-8 3.6-8 8v60c0 4.4 3.6 8 8 8 190.5 0 346-155.5 346-346zm-98-98c0-4.4-3.6-8-8-8h-60c-4.4 0-8 3.6-8 8 0 84.2-68.8 153-153 153-4.4 0-8 3.6-8 8v60c0 4.4 3.6 8 8 8 134.4 0 245-110.6 245-245zm-240-42c-39.5 0-76.2 13.4-104.8 35.7-10.7 8.4-13.2 23.9-5.6 35.2l22.2 33.4c7 10.4 20.9 14.3 32.7 8.6 15.3-7.5 32.5-11.7 50.5-11.7 62 0 113 51 113 113 0 18-4.2 35.2-11.7 50.5-5.7 11.8-1.8 25.7 8.6 32.7l33.4 22.2c11.3 7.5 26.8 5 35.2-5.6C794.6 536.2 808 499.5 808 460c0-97.2-78.8-176-176-176zm-17.1-48h-3.7c-121.3 0-221 99.7-221 221v3.7c0 6.8 7.7 10.5 13 6.3l56.4-44.9c2.6-2.1 3.2-5.9 1.2-8.5-12.3-16.9-19.6-37.7-19.6-60.3 0-56.4 45.8-102.3 102.3-102.3 22.5 0 43.4 7.3 60.3 19.6 2.6 1.9 6.4 1.3 8.5-1.2l44.9-56.4c3.8-5.4.1-13-6.3-13z" 
                          Fill="White" Stretch="Uniform" Width="18" Height="18" />
                </Button>
                
                <Button x:Name="PlayListButton" Classes="InvisibleButton"
                        Width="23" Height="23" Margin="6"
                        Click="PlayListButton_Click">
                    <!-- 播放列表图标 -->
                    <Path Data="M912 192H328c-4.4 0-8 3.6-8 8v56c0 4.4 3.6 8 8 8h584c4.4 0 8-3.6 8-8v-56c0-4.4-3.6-8-8-8zm0 284H328c-4.4 0-8 3.6-8 8v56c0 4.4 3.6 8 8 8h584c4.4 0 8-3.6 8-8v-56c0-4.4-3.6-8-8-8zm0 284H328c-4.4 0-8 3.6-8 8v56c0 4.4 3.6 8 8 8h584c4.4 0 8-3.6 8-8v-56c0-4.4-3.6-8-8-8zM104 228a56 56 0 1 0 112 0 56 56 0 1 0-112 0zm0 284a56 56 0 1 0 112 0 56 56 0 1 0-112 0zm0 284a56 56 0 1 0 112 0 56 56 0 1 0-112 0z" 
                          Fill="White" Stretch="Uniform" Width="18" Height="18" />
                </Button>
            </StackPanel>
        </Grid>
        
        <!-- 弹出菜单区域 - 后续实现 -->
        <!-- 播放模式弹出菜单 -->
        <Popup x:Name="PopMode" PlacementTarget="{Binding ElementName=ModeButton}"
               Placement="Top" Width="110" HorizontalOffset="-44"
               IsLightDismissEnabled="True">
            <!-- 播放模式控制将在后续实现 -->
        </Popup>
        
        <!-- 播放列表弹出菜单 -->
        <Popup x:Name="PopPlayList" PlacementTarget="{Binding ElementName=PlayListButton}"
               Placement="Top" Width="600" Height="500" HorizontalOffset="-570"
               IsLightDismissEnabled="True">
            <!-- 播放列表控制将在后续实现 -->
        </Popup>
        
        <!-- 音量控制弹出菜单 -->
        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=VolumeButton}"
               Placement="Top" MinWidth="170"
               IsLightDismissEnabled="True">
            <!-- 音量控制将在后续实现 -->
        </Popup>
    </Grid>
</UserControl>
