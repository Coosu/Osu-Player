<Window
  x:Class="Milki.OsuPlayer.MainWindow"
  x:Name="Root"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:userControls="using:Milki.OsuPlayer.UserControls"
  xmlns:vm="using:Milki.OsuPlayer.ViewModels"
  mc:Ignorable="d"
  x:DataType="vm:MainWindowViewModel"
  d:DesignWidth="998"
  d:DesignHeight="759"
  Title="Osu Player"
  Icon="avares://OsuPlayer/Assets/osuPlayer.ico"
  Width="998"
  Height="759"
  MinWidth="800"
  MinHeight="600"
  FontFamily="{StaticResource SspRegular}"
  FontSize="13"
  Background="#2D2D2D"
  ExtendClientAreaToDecorationsHint="True"
  ExtendClientAreaTitleBarHeightHint="40"
  WindowDecorations="None">
  <Window.DataContext>
    <vm:MainWindowViewModel />
  </Window.DataContext>

  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:HomePageViewModel}" x:DataType="vm:HomePageViewModel">
      <Grid ClipToBounds="True">
        <Image Source="avares://OsuPlayer/Assets/store.jpg" Stretch="UniformToFill" Opacity="0.72" />
        <Border Background="#74FFFFFF" />
        <Grid Margin="42,36">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock
              Text="{Binding PrimaryTitle}"
              FontSize="34"
              FontWeight="SemiBold"
              Foreground="#303030" />
            <TextBlock
              Margin="0,2,0,0"
              Text="{Binding SecondaryTitle}"
              FontSize="16"
              Foreground="#70606C" />
          </StackPanel>
          <Grid Grid.Row="1" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Classes="HomeMetric" Grid.Column="0">
              <StackPanel>
                <TextBlock Text="Library" Classes="HomeMetricCaption" />
                <TextBlock Text="Search" Classes="HomeMetricTitle" />
              </StackPanel>
            </Border>
            <Border Classes="HomeMetric" Grid.Column="1">
              <StackPanel>
                <TextBlock Text="Mine" Classes="HomeMetricCaption" />
                <TextBlock Text="Recent" Classes="HomeMetricTitle" />
              </StackPanel>
            </Border>
            <Border Classes="HomeMetric" Grid.Column="2">
              <StackPanel>
                <TextBlock Text="Collection" Classes="HomeMetricCaption" />
                <TextBlock Text="Default" Classes="HomeMetricTitle" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}" x:DataType="vm:PlaceholderPageViewModel">
      <Grid Background="#B0FFFFFF">
        <TextBlock
          Text="{Binding Title}"
          FontSize="28"
          FontWeight="SemiBold"
          Foreground="#303030"
          HorizontalAlignment="Center"
          VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="Border.HomeMetric">
      <Setter Property="Height" Value="86" />
      <Setter Property="Margin" Value="0,0,14,0" />
      <Setter Property="Padding" Value="18,13" />
      <Setter Property="Background" Value="#DFFFFFFF" />
      <Setter Property="BorderBrush" Value="#55FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="TextBlock.HomeMetricCaption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#8A6E7C" />
    </Style>

    <Style Selector="TextBlock.HomeMetricTitle">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#303030" />
    </Style>

    <Style Selector="Button.IconButton">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Foreground" Value="#F4F4F4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.IconButton:pointerover">
      <Setter Property="Background" Value="#2AFFFFFF" />
    </Style>

    <Style Selector="Button.IconButton:pressed">
      <Setter Property="Background" Value="#44FFFFFF" />
    </Style>

    <Style Selector="Button.CloseButton:pointerover">
      <Setter Property="Background" Value="#B8C72828" />
    </Style>

    <Style Selector="TextBlock.NavigationHeader">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F8E0DFEF" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="5,0,0,0" />
    </Style>

    <Style Selector="RadioButton.NavItem">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0,8,0" />
      <Setter Property="Margin" Value="0,0,0,1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border
            x:Name="NavItemBorder"
            Background="{TemplateBinding Background}"
            CornerRadius="0">
            <ContentPresenter
              Content="{TemplateBinding Content}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="RadioButton.NavItem:pointerover /template/ Border#NavItemBorder">
      <Setter Property="Background" Value="#F8F8F8" />
    </Style>

    <Style Selector="RadioButton.NavItem:checked /template/ Border#NavItemBorder">
      <Setter Property="Background" Value="#F8F8F8" />
    </Style>

    <Style Selector="RadioButton.NavItem:pointerover TextBlock">
      <Setter Property="Foreground" Value="#303030" />
    </Style>

    <Style Selector="RadioButton.NavItem:checked TextBlock">
      <Setter Property="Foreground" Value="#303030" />
    </Style>

    <Style Selector="RadioButton.NavItem:pointerover Path" x:DataType="vm:NavigationItemViewModel">
      <Setter Property="Fill" Value="{Binding SelectedColorHex}" />
    </Style>

    <Style Selector="RadioButton.NavItem:checked Path" x:DataType="vm:NavigationItemViewModel">
      <Setter Property="Fill" Value="{Binding SelectedColorHex}" />
    </Style>
  </Window.Styles>

  <Grid>
    <Grid.Background>
      <ImageBrush Source="avares://OsuPlayer/Assets/osu_texture.png" TileMode="Tile" DestinationRect="0,0,500,500" />
    </Grid.Background>

    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel
      x:Name="TitleBarAreaBack"
      Grid.Row="0"
      Height="40"
      LastChildFill="False"
      PointerPressed="TitleBarArea_PointerPressed">
      <Image
        Height="28"
        Margin="10,0,0,0"
        Source="avares://OsuPlayer/Assets/title.png"
        IsVisible="{Binding IsNavigationExpanded}" />
      <Image
        Height="28"
        Margin="10,0,0,0"
        Source="avares://OsuPlayer/Assets/title_sm.png"
        IsVisible="{Binding IsNavigationCollapsed}" />
      <TextBlock
        Margin="14,0,0,0"
        Text="{Binding CurrentPageTitle}"
        VerticalAlignment="Center"
        FontSize="14"
        Foreground="#DCF8F8F8" />
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" MinHeight="48" />
      </Grid.RowDefinitions>

      <Border
        Grid.Row="0"
        ZIndex="10"
        BorderThickness="1,0,1,0"
        IsHitTestVisible="False">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#DC498D" />
            <GradientStop Offset="1" Color="White" />
          </LinearGradientBrush>
        </Border.BorderBrush>
      </Border>

      <DockPanel Grid.Row="0" Margin="0,0,1,0">
        <Border
          Width="{Binding NavigationWidth}"
          DockPanel.Dock="Left"
          ClipToBounds="True">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="{Binding NavigationWidth}">
              <Button
                Classes="IconButton"
                Width="28"
                Height="28"
                Margin="9,1,1,1"
                HorizontalAlignment="Left"
                Command="{Binding CollapseCommand}"
                ToolTip.Tip="{Binding NavigationToggleToolTip}">
                <Path
                  Data="M96 192h832v96H96v-96zm0 272h832v96H96v-96zm0 272h832v96H96v-96z"
                  Fill="White"
                  Stretch="Uniform"
                  Width="17"
                  Height="17" />
              </Button>

              <Border
                Height="{Binding SectionHeaderHeight}"
                Margin="{Binding SectionHeaderMargin}"
                Background="#20FFFFFF">
                <TextBlock Classes="NavigationHeader" Text="{DynamicResource ui-nav-library}" />
              </Border>

              <ItemsControl ItemsSource="{Binding LibraryNavigationItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NavigationItemViewModel">
                    <RadioButton
                      Classes="NavItem"
                      Command="{Binding ActivateCommand}"
                      IsChecked="{Binding IsSelected}">
                      <Grid ColumnDefinitions="24,*">
                        <Path
                          Data="{Binding Icon}"
                          Fill="White"
                          Stretch="Uniform"
                          Width="18"
                          Height="18"
                          VerticalAlignment="Center" />
                        <TextBlock
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          Text="{Binding Key, Converter={StaticResource LocaleKeyToResourceConverter}}"
                          Foreground="White"
                          VerticalAlignment="Center"
                          TextTrimming="CharacterEllipsis"
                          IsVisible="{Binding IsTextVisible}" />
                      </Grid>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border
                Height="{Binding SectionHeaderHeight}"
                Margin="{Binding SectionHeaderMargin}"
                Background="#20FFFFFF">
                <TextBlock Classes="NavigationHeader" Text="{DynamicResource ui-nav-mine}" />
              </Border>

              <ItemsControl ItemsSource="{Binding MineNavigationItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NavigationItemViewModel">
                    <RadioButton
                      Classes="NavItem"
                      Command="{Binding ActivateCommand}"
                      IsChecked="{Binding IsSelected}">
                      <Grid ColumnDefinitions="24,*">
                        <Path
                          Data="{Binding Icon}"
                          Fill="White"
                          Stretch="Uniform"
                          Width="18"
                          Height="18"
                          VerticalAlignment="Center" />
                        <TextBlock
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          Text="{Binding Key, Converter={StaticResource LocaleKeyToResourceConverter}}"
                          Foreground="White"
                          VerticalAlignment="Center"
                          TextTrimming="CharacterEllipsis"
                          IsVisible="{Binding IsTextVisible}" />
                      </Grid>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <DockPanel
                Height="{Binding SectionHeaderHeight}"
                Margin="{Binding SectionHeaderMargin}"
                Background="#20FFFFFF">
                <TextBlock Classes="NavigationHeader" Text="{DynamicResource ui-nav-collection}" />
                <Button
                  Classes="IconButton"
                  DockPanel.Dock="Right"
                  Width="24"
                  Height="24"
                  Margin="0,3,4,3"
                  HorizontalAlignment="Right"
                  IsVisible="{Binding IsNavigationExpanded}">
                  <Path
                    Data="M448 96h128v352h352v128H576v352H448V576H96V448h352V96z"
                    Fill="#F4F4F4"
                    Stretch="Uniform"
                    Width="13"
                    Height="13" />
                </Button>
              </DockPanel>

              <ItemsControl ItemsSource="{Binding CollectionNavigationItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NavigationItemViewModel">
                    <RadioButton
                      Classes="NavItem"
                      Command="{Binding ActivateCommand}"
                      IsChecked="{Binding IsSelected}">
                      <Grid ColumnDefinitions="24,*">
                        <Path
                          Data="{Binding Icon}"
                          Fill="White"
                          Stretch="Uniform"
                          Width="18"
                          Height="18"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsTextVisible}" />
                        <Border
                          Width="26"
                          Height="26"
                          Background="White"
                          CornerRadius="13"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding !IsTextVisible}">
                          <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Title, Converter={StaticResource GetOutlinedTextConverter}}"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#303030" />
                        </Border>
                        <TextBlock
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          Text="{Binding Key, Converter={StaticResource LocaleKeyToResourceConverter}}"
                          Foreground="White"
                          VerticalAlignment="Center"
                          TextTrimming="CharacterEllipsis"
                          IsVisible="{Binding IsTextVisible}" />
                      </Grid>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <ContentControl Content="{Binding CurrentPage}" />
      </DockPanel>

      <userControls:PlayController Grid.Row="1" />
    </Grid>

    <DockPanel
      x:Name="TitleBarArea"
      Grid.Row="0"
      Height="40"
      LastChildFill="False"
      HorizontalAlignment="Right"
      PointerPressed="TitleBarArea_PointerPressed">
      <StackPanel
        Height="40"
        Margin="0,0,5,0"
        Orientation="Horizontal"
        VerticalAlignment="Center">
        <Border
          Height="32"
          Margin="0,0,10,0"
          Padding="10,2"
          VerticalAlignment="Center"
          BorderBrush="#60DDDDDD"
          BorderThickness="0.3"
          CornerRadius="16">
          <StackPanel Orientation="Horizontal">
            <Button Classes="IconButton" Width="25" Height="25" Margin="3,0" Click="SettingsButton_Click">
              <Path
                Data="M267.92 119.461c-0.425-3.778-4.83-6.617-8.639-6.617c-12.315 0-23.243-7.231-27.826-18.414c-4.682-11.454-1.663-24.812 7.515-33.231c2.889-2.641 3.24-7.062 0.817-10.133c-6.303-8.004-13.467-15.234-21.289-21.5c-3.063-2.458-7.557-2.116-10.213 0.825c-8.01 8.871-22.398 12.168-33.516 7.529c-11.57-4.867-18.866-16.591-18.152-29.176c0.235-3.953-2.654-7.39-6.595-7.849c-10.038-1.161-20.164-1.197-30.232-0.08c-3.896 0.43-6.785 3.786-6.654 7.689c0.438 12.461-6.946 23.98-18.401 28.672c-10.985 4.487-25.272 1.218-33.266-7.574c-2.642-2.896-7.063-3.252-10.141-0.853c-8.054 6.319-15.379 13.555-21.74 21.493c-2.481 3.086-2.116 7.559 0.802 10.214c9.353 8.47 12.373 21.944 7.514 33.53c-4.639 11.046-16.109 18.165-29.24 18.165c-4.261-0.137-7.296 2.723-7.762 6.597c-1.182 10.096-1.196 20.383-0.058 30.561c0.422 3.794 4.961 6.608 8.812 6.608c11.702-0.299 22.937 6.946 27.65 18.415c4.698 11.454 1.678 24.804-7.514 33.23c-2.875 2.641-3.24 7.055-0.817 10.126c6.244 7.953 13.409 15.19 21.259 21.508c3.079 2.481 7.559 2.131 10.228-0.81c8.04-8.893 22.427-12.184 33.501-7.536c11.599 4.852 18.895 16.575 18.181 29.167c-0.233 3.955 2.67 7.398 6.595 7.85c5.135 0.599 10.301 0.898 15.481 0.898c4.917 0 9.835-0.27 14.752-0.817c3.897-0.43 6.784-3.786 6.653-7.696c-0.451-12.454 6.946-23.973 18.386-28.657c11.059-4.517 25.286-1.211 33.281 7.572c2.657 2.89 7.047 3.239 10.142 0.848c8.039-6.304 15.349-13.534 21.74-21.494c2.48-3.079 2.13-7.559-0.803-10.213c-9.353-8.47-12.388-21.946-7.529-33.524c4.568-10.899 15.612-18.217 27.491-18.217l1.662 0.043c3.853 0.313 7.398-2.655 7.865-6.588C269.044 139.917 269.058 129.639 267.92 119.461z M134.595 179.491c-24.718 0-44.824-20.106-44.824-44.824c0-24.717 20.106-44.824 44.824-44.824c24.717 0 44.823 20.107 44.823 44.824C179.418 159.385 159.312 179.491 134.595 179.491z"
                Fill="White"
                Stretch="Uniform"
                Width="20"
                Height="20" />
            </Button>
            <Button Classes="IconButton" Width="25" Height="25" Margin="3,0" Click="MiniButton_Click">
              <Path
                Data="M192,195 L182,195 182,180 205,180 205,195 195,195 195,189 200,189 193.5,183 187,189 192,189"
                Fill="White"
                Stretch="Uniform"
                Width="16"
                Height="16" />
            </Button>
          </StackPanel>
        </Border>
        <Button Classes="IconButton" Click="MinimizeButton_Click">
          <Path Data="M160 512h704v80H160v-80z" Fill="White" Stretch="Uniform" Width="18" Height="18" />
        </Button>
        <Button Classes="IconButton" Click="MaximizeButton_Click">
          <Path Data="M224 224h576v576H224V224zm80 80v416h416V304H304z" Fill="White" Stretch="Uniform" Width="17" Height="17" />
        </Button>
        <Button Classes="IconButton CloseButton" Click="CloseButton_Click">
          <Path Data="M256 210 512 466 768 210 814 256 558 512 814 768 768 814 512 558 256 814 210 768 466 512 210 256 256 210z" Fill="White" Stretch="Uniform" Width="16" Height="16" />
        </Button>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
